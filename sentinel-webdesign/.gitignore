# Environment and secrets
.env
.env.local
*.env

# Runtime databases & caches
sentinel_db.json
database/team_rota.json
database/sentinel_users.json
.runtime/

# Logs & audit logs
logs/sentinel_audit.log
logs/
*.log
nas_logs/

# Dependencies & build outputs
node_modules/
# frontend/dist is COMMITTED so production hosts can run `npm ci --omit=dev`
# and never need the build toolchain. Guarded against staleness by:
#   npm run verify:dist
# The generic dist rule below is root-anchored (/dist/) so it does not swallow
# frontend/dist -- git cannot re-include a path inside an excluded directory,
# so a "!frontend/dist" negation would not work here.
apps/web/dist/
/dist/
*.zip
.tempmediaStorage/

# Validation harness browser profile (98MB, never commit)
tools/validation/chrome-profile/
tools/validation/screenshots/

# [T0.19] Dev-only identity fallback — never the system of record, never committed
database/sentinel_users.json

# Per-environment registry config (may contain an auth token)
.npmrc

# Repo-dump tooling output
repomix-output.xml
