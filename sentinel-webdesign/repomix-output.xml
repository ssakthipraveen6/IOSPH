<file path="deployments/ansible/playbook_linux_telemetry.yml">
---
- name: Deploy Selected Telemetry Collector to Linux Fleet
  hosts: linux_servers
  become: yes
  vars:
    # Telemetry Collector Choice: 'opentelemetry' (Default/Recommended) or 'node_exporter'
    telemetry_collector: "{{ collector_type | default('opentelemetry') }}"
    
    artifactory_otel_rpm_url: "https://artifactory-prod.internal.corp/artifactory/binaries/otelcol-contrib-0.95.0.x86_64.rpm"
    artifactory_node_exporter_url: "https://artifactory-prod.internal.corp/artifactory/binaries/node_exporter-1.7.0.linux-amd64.tar.gz"
    sentinel_url: "https://sentinel.yourbank.internal/v1/metrics"
    otel_token: "{{ lookup('env', 'SF_INFRA_OTEL_TOKEN') | default('SF-INFRA-OTEL-TOKEN', true) }}"

  tasks:
    # =========================================================================
    # CONDITION 1: Install OpenTelemetry Collector (When telemetry_collector == 'opentelemetry')
    # =========================================================================
    - name: "[OTEL] Disable node_exporter if present to prevent duplicate collection"
      systemd:
        name: node_exporter
        state: stopped
        enabled: no
      ignore_errors: yes
      when: telemetry_collector == 'opentelemetry'

    - name: "[OTEL] Download otelcol-contrib RPM package from internal Artifactory"
      get_url:
        url: "{{ artifactory_otel_rpm_url }}"
        dest: "/tmp/otelcol-contrib.rpm"
        mode: '0644'
      when: telemetry_collector == 'opentelemetry'

    - name: "[OTEL] Install otelcol-contrib RPM"
      yum:
        name: "/tmp/otelcol-contrib.rpm"
        state: present
      when: telemetry_collector == 'opentelemetry'

    - name: "[OTEL] Deploy OpenTelemetry configuration"
      copy:
        src: "../opentelemetry_configs/otel_linux_config.yaml"
        dest: "/etc/otelcol-contrib/config.yaml"
        owner: otel
        group: otel
        mode: '0640'
      when: telemetry_collector == 'opentelemetry'
      notify: Restart OTel Collector

    - name: "[OTEL] Ensure otelcol-contrib is enabled and started"
      systemd:
        name: otelcol-contrib
        enabled: yes
        state: started
      when: telemetry_collector == 'opentelemetry'

    # =========================================================================
    # CONDITION 2: Install Prometheus Node Exporter (When telemetry_collector == 'node_exporter')
    # =========================================================================
    - name: "[NODE-EXPORTER] Disable otelcol-contrib if present"
      systemd:
        name: otelcol-contrib
        state: stopped
        enabled: no
      ignore_errors: yes
      when: telemetry_collector == 'node_exporter'

    - name: "[NODE-EXPORTER] Create prometheus user group"
      group:
        name: prometheus
        system: yes
      when: telemetry_collector == 'node_exporter'

    - name: "[NODE-EXPORTER] Create node_exporter user"
      user:
        name: node_exporter
        group: prometheus
        system: yes
        shell: /sbin/nologin
      when: telemetry_collector == 'node_exporter'

    - name: "[NODE-EXPORTER] Download & Unarchive node_exporter"
      unarchive:
        src: "{{ artifactory_node_exporter_url }}"
        dest: "/tmp"
        remote_src: yes
      when: telemetry_collector == 'node_exporter'

    - name: "[NODE-EXPORTER] Copy binary to /usr/local/bin"
      copy:
        src: "/tmp/node_exporter-1.7.0.linux-amd64/node_exporter"
        dest: "/usr/local/bin/node_exporter"
        owner: node_exporter
        group: prometheus
        mode: '0755'
        remote_src: yes
      when: telemetry_collector == 'node_exporter'

    - name: "[NODE-EXPORTER] Deploy systemd service"
      copy:
        dest: "/etc/systemd/system/node_exporter.service"
        content: |
          [Unit]
          Description=Prometheus Node Exporter
          After=network.target

          [Service]
          User=node_exporter
          Group=prometheus
          Type=simple
          ExecStart=/usr/local/bin/node_exporter --web.listen-address=:9100
          Restart=always

          [Install]
          WantedBy=multi-user.target
      when: telemetry_collector == 'node_exporter'
      notify: Restart Node Exporter

    - name: "[NODE-EXPORTER] Ensure node_exporter is enabled and started"
      systemd:
        name: node_exporter
        enabled: yes
        state: started
        daemon_reload: yes
      when: telemetry_collector == 'node_exporter'

  handlers:
    - name: Restart OTel Collector
      systemd:
        name: otelcol-contrib
        state: restarted

    - name: Restart Node Exporter
      systemd:
        name: node_exporter
        state: restarted
</file>

<file path="deployments/fluentbit_configs/fluentbit_base.conf">
# =========================================================================
# Project Sentinel: Enterprise Fluent Bit Base Configuration (Phase 3b / T3b.1)
# Features: Persistent Tail, Redaction Filters (PANs, Tokens, PII), Sentinel Ingest
# =========================================================================

[SERVICE]
    Flush         1
    Log_Level     info
    Daemon        off
    Parsers_File  parsers.conf

[INPUT]
    Name              tail
    Tag               app.log
    Path              /var/log/apps/*.log,/opt/sentinel/logs/*.log
    DB                /var/log/fluentbit_tail.db
    Mem_Buf_Limit     50MB
    Skip_Long_Lines   On
    Refresh_Interval  5

# =========================================================================
# Redaction Filters (T3b.6 — Strip Tokens, Secrets, PANs & PII at the Host)
# =========================================================================
[FILTER]
    Name          modify
    Match         *
    # Mask Credit Card Numbers / PANs (13 to 19 digits)
    Condition     Key_Value_Matches message \b(?:\d[ -]*?){13,19}\b
    Set           redacted_pan true

[FILTER]
    Name          rewrite_tag
    Match         app.log
    Rule          $message "(?i)(password|secret|bearer\s+[a-zA-Z0-9_\-\.]+)" sensitive.masked false

[FILTER]
    Name          modify
    Match         *
    Add           deployment.environment ${SENTINEL_ENV}
    Add           host.name ${HOSTNAME}
    Add           shipper.version 3.0.4

# =========================================================================
# Sentinel HTTP Output (POST /v1/logs)
# =========================================================================
[OUTPUT]
    Name          http
    Match         *
    Host          sentinel.yourbank.internal
    Port          443
    URI           /v1/logs
    Format        json
    Header        X-Sentinel-Environment ${SENTINEL_ENV}
    Header        Authorization Bearer ${SENTINEL_SHIPPER_TOKEN}
    Tls           On
    Tls.verify    On
    Retry_Limit   5
</file>

<file path="deployments/fluentbit_configs/parsers.conf">
[PARSER]
    Name        json
    Format      json
    Time_Key    time
    Time_Format %Y-%m-%dT%H:%M:%S.%L

[PARSER]
    Name        log4j
    Format      regex
    Regex       ^(?<time>[^ ]* [^ ]*) \[(?<thread>.*)\] (?<level>[^\s]+)\s+(?<logger>[^\s]+) - (?<message>.*)$
    Time_Key    time
    Time_Format %Y-%m-%d %H:%M:%S

[PARSER]
    Name        syslog
    Format      regex
    Regex       ^\<(?<pri>[0-9]+)\>(?<time>[^ ]* {1,2}[^ ]* [^ ]*) (?<host>[^ ]*) (?<ident>[a-zA-Z0-9_\/\.\-]*)(?:\[(?<pid>[0-9]+)\])?(?:[^\:]*\:)? *(?<message>.*)$
    Time_Key    time
    Time_Format %b %d %H:%M:%S
</file>

