    Ingest->>PG: INSERT INTO metrics (timestamp, component, metric_name, value, environment)
    Ingest-->>OTel: HTTP 200 { status: "SUCCESS", count: 4 }
    DB->>WS: broadcastStateChange()
    WS->>UI: Live tick → Jenkins Tile CPU updates to 67.4%
