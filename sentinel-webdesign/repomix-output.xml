---
# =============================================================================
# Ansible Playbook: Deploy Fluent Bit Log Shipper (Phase 3b / T3b.1)
# Pinned version, host-level redaction filters, systemd service management.
# =============================================================================
- name: Deploy Fluent Bit Log Shipper across Linux Compute Fleet
  hosts: linux_compute_nodes
  become: yes
  vars:
    fluentbit_version: "3.0.4"
    sentinel_endpoint: "https://sentinel.yourbank.internal/v1/logs"
    sentinel_env: "{{ target_env | default('staging') }}"
    shipper_token: "{{ vault_sentinel_shipper_token }}"

  tasks:
    - name: Ensure fluent-bit package repository is configured
      apt_repository:
        repo: "deb https://packages.fluentbit.io/ubuntu/{{ ansible_distribution_release }} {{ ansible_distribution_release }} main"
        state: present
        filename: fluent-bit
      when: ansible_os_family == "Debian"

    - name: Ensure fluent-bit package repository (RHEL/CentOS)
      yum_repository:
        name: fluent-bit
        description: Fluent Bit Repository
        baseurl: "https://packages.fluentbit.io/centos/$releasever/$basearch/"
        gpgcheck: yes
        gpgkey: "https://packages.fluentbit.io/fluentbit.key"
        enabled: yes
      when: ansible_os_family == "RedHat"

    - name: Install pinned Fluent Bit package
      package:
        name: "fluent-bit-{{ fluentbit_version }}"
        state: present

    - name: Deploy Fluent Bit base configuration
      template:
        src: ../fluentbit_configs/fluentbit_base.conf
        dest: /etc/fluent-bit/fluent-bit.conf
        owner: root
        group: root
        mode: '0640'
      notify: restart_fluentbit

    - name: Deploy parsers configuration
      copy:
        src: ../fluentbit_configs/parsers.conf
        dest: /etc/fluent-bit/parsers.conf
        owner: root
        group: root
        mode: '0644'
      notify: restart_fluentbit

    - name: Ensure Fluent Bit systemd service is enabled and started
      systemd:
        name: fluent-bit
        enabled: yes
        state: started

  handlers:
    - name: restart_fluentbit
      systemd:
        name: fluent-bit
        state: restarted
</file>

<file path="deployments/ansible/playbook_linux_node_exporter.yml">
---
- name: Deploy Prometheus Node Exporter on Linux Hosts
  hosts: linux_servers
  become: yes
  vars:
    node_exporter_tar_url: "https://artifactory-prod.internal.corp/artifactory/binaries/node_exporter-1.7.0.linux-amd64.tar.gz"
    node_exporter_port: 9100

  tasks:
    - name: Create prometheus system group
      group:
        name: prometheus
        system: yes

    - name: Create prometheus system user
      user:
        name: node_exporter
        group: prometheus
        system: yes
        shell: /sbin/nologin

    - name: Download and unarchive Node Exporter from internal Artifactory
      unarchive:
        src: "{{ node_exporter_tar_url }}"
        dest: "/tmp"
        remote_src: yes

    - name: Copy binary to /usr/local/bin
      copy:
        src: "/tmp/node_exporter-1.7.0.linux-amd64/node_exporter"
        dest: "/usr/local/bin/node_exporter"
        owner: node_exporter
        group: prometheus
        mode: '0755'
        remote_src: yes

    - name: Deploy systemd service definition
      copy:
        dest: "/etc/systemd/system/node_exporter.service"
        content: |
          [Unit]
          Description=Prometheus Node Exporter
          Wants=network-online.target
          After=network-online.target

          [Service]
          User=node_exporter
          Group=prometheus
          Type=simple
          ExecStart=/usr/local/bin/node_exporter --web.listen-address=:{{ node_exporter_port }}
          Restart=always
          RestartSec=5s

          [Install]
          WantedBy=multi-user.target
      notify: Reload Systemd and Restart Node Exporter

    - name: Ensure node_exporter service is started and enabled
      systemd:
        name: node_exporter
        enabled: yes
        state: started

  handlers:
    - name: Reload Systemd and Restart Node Exporter
      systemd:
        daemon_reload: yes
        name: node_exporter
        state: restarted
</file>

