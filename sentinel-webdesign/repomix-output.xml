# =========================================================================
# PRODUCTION ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# Copy this file to .env or export environment variables in Kubernetes/Linux/Windows
# =========================================================================

# [SEC-01 REQUIRED] JWT Signing Secret — MUST be set; server will refuse to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters. 64+ recommended for production.
SENTINEL_JWT_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET_HERE>

# JWT Session TTL in milliseconds (optional; default = 8 hours = 28800000)
# JWT_TTL_MS=28800000

# TOGGLE: Set to false to switch from simulated collectors to REAL production APIs & DBs
USE_SIMULATED_COLLECTORS=false

# PORT: Express backend API port
PORT=3001

# [SEC-05] CORS: Exact origin allowed for production (no wildcard or substring matching)
ALLOWED_ORIGIN=https://sentinel.yourbank.internal

# [NX-02 REQUIRED] PostgreSQL TLS — certificate path for server validation
# PG_CA_CERT_PATH=/etc/ssl/certs/pg-ca.crt

# DATABASE CONNECTIVITY: PostgreSQL / TimescaleDB
# [NX-02] Do NOT store DB passwords in .env — resolve via CyberArk at runtime.
# Provide the CyberArk registry entry for 'db'/'write' credential instead.
PROD_DB_JDBC=jdbc:postgresql://db-prod-primary.internal.corp:5432/telemetry_db
PGUSER=pg_telemetry_writer
# PGPASSWORD — NOT stored here; resolved from CyberArk at runtime via credential_provider

# APPLICATION ENDPOINTS REGISTRY
PROD_BITBUCKET_API=https://bitbucket-prod.internal.corp/rest/api/1.0
