import React, { useState, useEffect } from 'react';
import { MAINTENANCE_CONFIG } from '../../maintenanceConfig';
import { MaintenanceBadge, MaintenanceBanner } from '../shared/MaintenanceNotice';

export default function YamlConfigManager({ environment = 'staging' }) {
  const currentEnv = environment || 'staging';
  const [applications, setApplications] = useState({});
  const [selectedApp, setSelectedApp] = useState(null); // null = global_config.yaml
  const [rawYaml, setRawYaml] = useState('');
  const [statusMessage, setStatusMessage] = useState('');
  const [prData, setPrData] = useState(null);
  const [loading, setLoading] = useState(false);
  const [commitMsg, setCommitMsg] = useState('');

  async function fetchApps() {
    try {
      const res = await fetch('/api/yaml/all');
      if (res.ok) {
        const data = await res.json();
        setApplications(data.applications || {});
      }
    } catch (err) {
      console.error('Failed fetching YAML apps:', err);
    }
  }

  async function loadYaml(appId) {
    setSelectedApp(appId);
    setStatusMessage('');
    setPrData(null);
    setLoading(true);
    try {
      const url = appId ? `/api/yaml/raw?appId=${appId}` : '/api/yaml/raw';
      const res = await fetch(url);
      const data = await res.json();
      setRawYaml(data.yaml || '');
      setCommitMsg(`Config Update: Update ${appId ? `applications/${appId}.yaml` : 'global_config.yaml'}`);
    } catch (err) {
      setStatusMessage(`❌ Error loading YAML: ${err.message}`);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    fetchApps();
    loadYaml(null);
  }, [environment]);

  const handleCopyToClipboard = async () => {
    try {
      await navigator.clipboard.writeText(rawYaml);
      setStatusMessage('📋 Configuration copied to clipboard! (Live runtime edits disabled per GitOps policy — submit changes via Git PR)');
    } catch (err) {
      setStatusMessage('❌ Error copying to clipboard.');
    }
  };

  const appKeys = Object.keys(applications);

  return (
    <div className="yaml-manager-container" style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem' }}>
