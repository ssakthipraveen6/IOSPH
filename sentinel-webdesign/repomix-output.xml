      { name: "Platform Engineer 5", email: "pe5@sentinel.local", pager: "PAGER-BAU-05", loc: "Ops Center Epsilon" }
    ];

    for (let day = 1; day <= daysInMonth; day++) {
      const dateStr = `${prefix}-${String(day).padStart(2, '0')}`;
      const d = new Date(year, month, day);
