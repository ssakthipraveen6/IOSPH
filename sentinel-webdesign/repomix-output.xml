  if (req.path.includes('/302-idp') || req.query.mode === '302-idp' || failures.samlRedirect) {
    return res.redirect(302, 'https://idp.enterprise.corp/saml/login');
  }
  if (req.path.includes('/500') || req.query.mode === '500' || failures.serverError) {
