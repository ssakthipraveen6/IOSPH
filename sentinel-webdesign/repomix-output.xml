function generateMonthlyRoster(category = 'core', forDate = new Date()) {
  const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const rows = [];

  const year       = forDate.getFullYear();
  const month      = forDate.getMonth();           // 0-indexed (0=Jan, 7=Aug)
