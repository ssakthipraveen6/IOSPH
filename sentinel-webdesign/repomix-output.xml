      if (res.ok) {
        registryHealthy = true;
        try {
          parsedMetrics = await res.json();
        } catch (_) {}
      }
    } catch (_) {}
  }

  const metrics = {
    registry_status: isOutage ? 'Critical' : (registryHealthy ? 'Healthy' : null),
