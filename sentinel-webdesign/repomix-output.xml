                                ) : (
                                  <span style={{ color: isToday ? 'var(--text-main)' : 'var(--text-muted)' }}>
                                    {val || '—'}
                                  </span>
                                )}
                              </td>
                            );
                          })}
                        </tr>
                      );
                    })
                  )}
                </tbody>
              </table>
            </div>
          </div>

        </div>
