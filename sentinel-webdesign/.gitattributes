# Line endings. Linux-side files must stay LF or they break on the target hosts
# (bash reads "\r" as part of the command; systemd rejects CR in unit files).
* text=auto
*.sh       text eol=lf
*.service  text eol=lf
*.flags    text eol=lf
*.conf     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
Jenkinsfile text eol=lf
# Windows-only scripts keep CRLF.
*.bat      text eol=crlf
*.cmd      text eol=crlf
# Binaries.
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
*.msi  binary
