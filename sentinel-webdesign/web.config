<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Windows Server IIS Deployment Configuration for Project Sentinel
  Supports RefWeb Reverse Proxy, IIS ARR, URL Rewrite, and HttpPlatformHandler / iisnode
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- HttpPlatformHandler routes all requests directly to the Node.js process -->
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    
    <httpPlatform processPath="node.exe"
                  arguments="apps\api\src\server.js"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".runtime\nas_logs\iis_node.log"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOST" value="0.0.0.0" />
      </environmentVariables>
    </httpPlatform>

    <!-- Enable Dynamic & Static Compression in IIS -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Security & Header Restrictions -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>

    <!-- WebSockets support on Windows Server IIS -->
    <webSocket enabled="true" receiveBufferLimit="4194304" pingInterval="00:00:30" />
  </system.webServer>
</configuration>
