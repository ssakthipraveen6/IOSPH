# =========================================================================
# PRODUCTION ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# Copy this file to .env or export environment variables in Kubernetes/Linux/Windows
# =========================================================================

# TOGGLE: Set to false to switch from simulated collectors to REAL production APIs & DBs
USE_SIMULATED_COLLECTORS=false

# PORT: Express backend API port
PORT=3001

# DATABASE CONNECTIVITY: PostgreSQL / TimescaleDB & Snowflake
PROD_DB_JDBC=jdbc:postgresql://db-prod-primary.internal.corp:5432/telemetry_db
PGUSER=pg_telemetry_writer
PGPASSWORD=STG_PG_SECURE_PASSWORD_VAL

# APPLICATION ENDPOINTS REGISTRY
PROD_BITBUCKET_API=https://bitbucket-prod.internal.corp/rest/api/1.0
PROD_ARTIFACTORY_API=https://artifactory-prod.internal.corp/artifactory/api
PROD_FORTIFY_API=https://fortify-prod.internal.corp/ssc/api/v1
PROD_NEXUSIQ_API=https://nexusiq-prod.internal.corp/api/v2
PROD_SONARQUBE_API=https://sonarqube-prod.internal.corp/api
PROD_JENKINS_MASTER_URL=https://jenkins-prod.internal.corp/job
PROD_TEAMCITY_API=https://teamcity-prod.internal.corp/app/rest
PROD_ARGOCD_API=https://argocd-prod.internal.corp/api/v1
PROD_ARGOWORKFLOWS_API=https://argo-workflows-prod.internal.corp/api/v1
PROD_BITBUCKET_EXTERNAL_API=https://bitbucket-external-prod.internal.corp/rest/api/1.0
PROD_OTKR_API=https://otkr-prod.internal.corp/api/v1
PROD_PERFORMANCE_CENTER_API=https://perfcenter-prod.internal.corp/api/v2

# INFRASTRUCTURE LAYERS REGISTRY
PROD_AVI_API=https://avi-prod.internal.corp/api/v1/telemetry
PROD_SSO_API=https://sso-auth-prod.internal.corp/oauth2/token
PROD_NAS_MOUNT=d:\production_shares\nas_logs
PROD_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
PROD_WINDOWS_API=https://win-compute-prod.internal.corp/api/v1/metrics
PROD_UNIX_API=https://linux-compute-prod.internal.corp/api/v1/metrics
PROD_K8S_API=https://k8s-apiserver-prod.internal.corp:6443
